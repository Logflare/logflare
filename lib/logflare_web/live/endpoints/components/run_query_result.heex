<div :if={match?(%{kind: :endpoint, status: :ok}, @test_result)}>
  <div class="tw-flex tw-justify-between">
    <h5 class="tw-text-white">Results</h5>

    <QueryComponents.query_cost :if={is_integer(@test_result.total_bytes_processed)} bytes={@test_result.total_bytes_processed} />
  </div>

  <code class="tw-whitespace-pre-wrap tw-overflow-x-auto tw-block tw-text-white tw-bg-zinc-800 tw-rounded tw-p-2 tw-text-xs">
    {Jason.encode!(@test_result.rows) |> Jason.Formatter.pretty_print()}
  </code>
</div>
