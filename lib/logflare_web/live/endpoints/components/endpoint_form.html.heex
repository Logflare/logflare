<div id="endpoint-edit" class="tw-grid tw-grid-cols-1 tw-gap-8 tw-py-5 lg:tw-grid-cols-2">
  <.form :let={f} for={@endpoint_changeset} as={:endpoint} id="endpoint" phx-change="validate" phx-submit="save-endpoint" class="tw-flex tw-min-w-0 tw-flex-col tw-gap-5">
    <.input field={f[:language]} type="hidden" />
    <div class="tw-flex tw-items-center tw-justify-between tw-gap-4">
      <button :if={@show_endpoint} data-confirm="Are you sure? This cannot be undone" phx-click="delete-endpoint" phx-value-endpoint_id={@show_endpoint.id} class="btn btn-outline-danger" type="button">
        <i class="fas fa-trash"></i> Delete
      </button>
      <.button type="submit" variant="primary" class="tw-ml-auto">Save changes</.button>
    </div>

    <section class="tw-rounded tw-border tw-bg-dashboard-grey tw-p-5">
      <h3 class="tw-mb-4 tw-text-xl tw-font-semibold tw-text-white">Endpoint details</h3>
      <div class="form-group">
        {label(f, :name, "Name")}
        <.input field={f[:name]} placeholder="YourApp.EndpointName" class="form-control form-control-margin" phx-update="ignore" />
        {error_tag(f, :name)}
        <small class="form-text text-muted">
          This endpoint will can be queried at:<br />
          <code>{url(~p"/api/endpoints/query/YourApp.EndpointName")}</code>
        </small>
      </div>

      <div class="form-group">
        {label(f, :description, "Description")}
        <div class="input-group">
          {textarea(f, :description, class: "form-control", "phx-update": "ignore")}
        </div>
        {error_tag(f, :description)}
        <small class="form-text text-muted">
          Add a helpful description for what this endpoint is used for.
        </small>
      </div>

      <QueryComponents.backend_select :if={@show_backend_selection} backends={@backends} form={f} label="Backend (optional)" default_backend={@default_backend}>
        <:help>Choose which backend to execute this endpoint query against.</:help>
      </QueryComponents.backend_select>
    </section>

    <section class="tw-min-w-0 tw-rounded tw-border tw-bg-dashboard-grey tw-p-5">
      <h3 class="tw-mb-4 tw-text-xl tw-font-semibold tw-text-white">Query</h3>
      <div>
        <p class="tw-text-sm tw-text-zinc-400">
          This endpoint will execute this query on each <code>GET</code> request.
          Declare parameters using <code>@parameter_name</code> and pass it to the endpoint via query parameters <code>?parameter_name=some-value</code>
        </p>

        <.live_component
          module={LogflareWeb.MonacoEditorComponent}
          id="endpoint_query_editor"
          field={f[:query]}
          endpoints={@endpoints}
          alerts={@alerts}
          sources={@sources}
          on_query_change={
            fn query_string ->
              send(self(), {:query_string_updated, query_string})
            end
          }
        />
      </div>
    </section>

    <section class="tw-rounded tw-border tw-bg-dashboard-grey tw-p-5">
      <h3 class="tw-mb-4 tw-text-xl tw-font-semibold tw-text-white">Settings</h3>
      <div class="form-group">
        {label(f, :max_limit, "Max rows")}
        <div class="input-group">
          <.input field={f[:max_limit]} placeholder={if @show_endpoint, do: nil, else: 1000} />
          <div class="input-group-append">
            <span class="input-group-text">rows</span>
          </div>
        </div>
        {error_tag(f, :max_limit)}
        <small class="form-text text-muted">
          This option determines the maximum result size returned from the backend.
        </small>
      </div>

      <div class="form-group form-check">
        <.input field={f[:enable_auth]} type="checkbox" id="auth-checkbox" />
        {label(f, :enable_auth, "Enable authentication",
          for: "auth-checkbox",
          class: "form-check-label"
        )}
        {error_tag(f, :enable_auth)}
        <small class="form-text text-muted">
          Endpoints with authentication enabled will require an access token to be provided on each request.
        </small>
      </div>

      <div class="form-group form-check">
        <.input field={f[:sandboxable]} type="checkbox" id="sandboxable-checkbox" />
        {label(f, :sandboxable, "Enable query sandboxing",
          for: "sandboxable-checkbox",
          class: "form-check-label"
        )}
        {error_tag(f, :sandboxable)}
        <small class="form-text text-muted">
          Endpoints with sandboxing enabled will accept an <code>?sql=</code> query parameter that will be inserted as the outer query of the defined CTE.
          This restricts users of the endpoint to only query within the defined CTE result sets.
        </small>
      </div>

      <div class="form-group form-check">
        <.input field={f[:redact_pii]} type="checkbox" id="redact-pii-checkbox" />
        {label(f, :redact_pii, "Redact PII from query results",
          for: "redact-pii-checkbox",
          class: "form-check-label"
        )}
        {error_tag(f, :redact_pii)}
        <small class="form-text text-muted">
          When enabled, PII such as IP addresses in query results will be "REDACTED"
        </small>
      </div>

      <div class="form-check">
        <.input field={f[:enable_dynamic_reservation]} type="checkbox" id="dynamic-reservation-checkbox" />
        {label(f, :enable_dynamic_reservation, "Enable dynamic BigQuery reservation",
          for: "dynamic-reservation-checkbox",
          class: "form-check-label"
        )}
        {error_tag(f, :enable_dynamic_reservation)}
        <small class="form-text text-muted">
          When enabled, API callers can set the BigQuery reservation for query execution using the <code>LF-ENDPOINT-BIGQUERY-RESERVATION</code> request header.
          The value should be in the format <code>{"projects/{project}/locations/{location}/reservations/{reservation}"}</code>.
        </small>
      </div>
    </section>

    <section class="tw-flex tw-flex-col tw-gap-4 tw-rounded tw-border tw-bg-dashboard-grey tw-p-5">
      <h3 class="tw-mb-0 tw-text-xl tw-font-semibold tw-text-white">Caching</h3>
      <div>
        {label(f, :cache_duration_seconds, "Cache TTL")}
        <div class="input-group">
          <.input field={f[:cache_duration_seconds]} placeholder={if @show_endpoint, do: nil, else: 3600} />
          <div class="input-group-append">
            <span class="input-group-text">seconds</span>
          </div>
        </div>
        {error_tag(f, :cache_duration_seconds)}
        <small class="form-text text-muted">
          Endpoint results are cached on a per-request basis. Set Cache TTL to <code>0</code> to disable caching completely.
        </small>
      </div>
      <div>
        {label(f, :proactive_requerying_seconds, "Proactive Re-querying")}
        <div class="input-group">
          <.input field={f[:proactive_requerying_seconds]} placeholder={if @show_endpoint, do: nil, else: 1800} />
          <div class="input-group-append">
            <span class="input-group-text">seconds</span>
          </div>
        </div>
        {error_tag(f, :proactive_requerying_seconds)}
        <small class="form-text text-muted">
          Cached results will be refreshed at this interval. Ignored if caching is disabled.
        </small>
      </div>
    </section>
    <section class="tw-rounded tw-border tw-bg-dashboard-grey tw-p-5">
      <h3 class="tw-mb-4 tw-text-xl tw-font-semibold tw-text-white">Query execution labels</h3>
      <div>
        {label(f, :labels, "Query execution labels", class: "tw-sr-only")}
        <div class="input-group">
          <.input field={f[:labels]} placeholder={if @show_endpoint, do: nil, else: ""} />
        </div>
        {error_tag(f, :labels)}
        <small class="form-text text-muted">
          A comma-separated allowlist of labels to be added to the query execution backend. To reference parameters, use the format <code>my_param=@my_param,my_other_field,meta</code>.
          Key value pairs will be added to the query execution backend using the <code>LF-ENDPOINT-LABELS: my_other_field=some-val,meta=123</code> request header.
        </small>
      </div>
    </section>
  </.form>
  <RunQuery.endpoint_test endpoint={Ecto.Changeset.apply_changes(@endpoint_changeset)} form={@params_form} declared_params={@declared_params} result={@test_result} editing />
</div>
