#!/usr/bin/env python3
"""Prepare application or chart-only releases without publishing anything."""

import argparse
import difflib
from pathlib import Path
import re
import sys


VERSION_PATTERN = r"(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)"


def version_parts(value):
    if not re.fullmatch(VERSION_PATTERN, value):
        raise ValueError(f"Invalid version {value!r}; expected stable X.Y.Z (no leading zeros).")
    return tuple(map(int, value.split(".")))


def chart_field(text, key):
    lines = list(re.finditer(rf"^{key}:[^\n]*$", text, re.MULTILINE))
    if len(lines) != 1:
        raise ValueError(f"helm/Chart.yaml must contain exactly one top-level {key} field.")
    line = lines[0]
    scalar = re.fullmatch(
        rf"({key}:[ \t]*)([\"']?)({VERSION_PATTERN})\2([ \t]*(?:#.*)?)",
        line.group(),
    )
    if scalar is None:
        raise ValueError(f"Unsupported {key} field in helm/Chart.yaml; expected stable X.Y.Z.")
    return line, scalar


def replace_chart_field(text, key, value):
    line, scalar = chart_field(text, key)
    quote = '"' if key == "appVersion" else scalar[2]
    replacement = f"{scalar[1]}{quote}{value}{quote}{scalar[4]}"
    return text[:line.start()] + replacement + text[line.end():]


def parse_args():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("version", nargs="?", help="New application version (stable X.Y.Z)")
    parser.add_argument("--chart-only", action="store_true", help="Bump only the Helm chart version")
    parser.add_argument("--chart-version", help="Explicit chart version; defaults to a patch bump")
    parser.add_argument("--dry-run", action="store_true", help="Print the proposed diff without writing")
    parser.add_argument("--check", action="store_true", help="Validate current versions without writing")
    args = parser.parse_args()
    if args.check:
        if args.version is not None or args.chart_only or args.chart_version is not None or args.dry_run:
            parser.error("--check cannot be combined with bump options")
    elif args.chart_only:
        if args.version is not None:
            parser.error("--chart-only cannot be combined with an application version")
    elif not args.version:
        parser.error("provide an application version or --chart-only")
    return args


def main():
    args = parse_args()
    root = Path(__file__).resolve().parent.parent
    version_path = root / "VERSION"
    chart_path = root / "helm" / "Chart.yaml"
    try:
        version_text = version_path.read_text(encoding="utf-8")
        chart_text = chart_path.read_text(encoding="utf-8")
        current_app = version_text.strip()
        current_app_parts = version_parts(current_app)
        _, app_scalar = chart_field(chart_text, "appVersion")
        _, chart_scalar = chart_field(chart_text, "version")
        current_chart = chart_scalar[3]
        current_chart_parts = version_parts(current_chart)
        if app_scalar[3] != current_app:
            raise ValueError(
                f"helm/Chart.yaml appVersion ({app_scalar[3]}) does not match VERSION ({current_app}). "
                "Resolve the mismatch before bumping."
            )
        if args.check:
            print(f"Chart appVersion matches VERSION: {current_app}; chart version: {current_chart}")
            return 0

        new_app = current_app if args.chart_only else args.version
        if not args.chart_only and version_parts(new_app) <= current_app_parts:
            raise ValueError(f"Application version must be greater than {current_app}.")
        major, minor, patch = current_chart_parts
        new_chart = args.chart_version if args.chart_version is not None else f"{major}.{minor}.{patch + 1}"
        if version_parts(new_chart) <= current_chart_parts:
            raise ValueError(f"Chart version must be greater than {current_chart}.")

        new_chart_text = replace_chart_field(chart_text, "version", new_chart)
        if not args.chart_only:
            new_chart_text = replace_chart_field(new_chart_text, "appVersion", new_app)
        changes = [(chart_path, chart_text, new_chart_text)]
        if not args.chart_only:
            changes.insert(0, (version_path, version_text, new_app + "\n"))
        for path, old, new in changes:
            name = path.relative_to(root).as_posix()
            if args.dry_run:
                sys.stdout.writelines(difflib.unified_diff(
                    old.splitlines(keepends=True), new.splitlines(keepends=True),
                    fromfile=f"a/{name}", tofile=f"b/{name}",
                ))
            else:
                path.write_text(new, encoding="utf-8")
        if not args.dry_run:
            print(f"Application: {current_app} -> {new_app}; chart: {current_chart} -> {new_chart}")
        return 0
    except (OSError, ValueError) as error:
        print(f"bump-release: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
