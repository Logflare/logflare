<.subheader>
  <:path>
    ~/<.subheader_path_link live_patch to={~p"/endpoints"} team={@team}>endpoints</.subheader_path_link>/{@show_endpoint.name}
  </:path>
  <.subheader_link team={@team} to={~p"/access-tokens"} text="access tokens" fa_icon="key" />
  <.subheader_link team={@team} to={~p"/endpoints/#{@show_endpoint.id}/versions"} text="versions" fa_icon="history" />
  <.subheader_link team={@team} live_patch to={~p"/endpoints/#{@show_endpoint.id}/edit"} text="edit" fa_icon="edit" />
</.subheader>
<section class="container mx-auto tw-flex tw-flex-col tw-gap-5 tw-py-5">
  <Components.authentication_warning endpoint={@show_endpoint} />

  <div id="endpoint-show" class="tw-grid tw-grid-cols-1 tw-gap-8 lg:tw-grid-cols-2">
    <Components.endpoint_details endpoint={@show_endpoint} parsed_result={@parsed_result} redact_pii={@redact_pii} />
    <Components.endpoint_test endpoint={@show_endpoint} form={@params_form} declared_params={@declared_params} result={@test_result} />
  </div>
</section>
