<.subheader>
  <:path>
    ~/<.subheader_path_link live_patch to={~p"/alerts"} team={@team}>alerts</.subheader_path_link>
  </:path>
  <.render_docs_link {assigns} />
</.subheader>

<div class="tw-p-4 lg:tw-max-w-[50%] tw-mx-auto">
  <h3 class="tw-text-white">Logflare Alerts</h3>
  <p>
    Logflare Alerts are scheduled queries that run against your sources.
    With Alerts, you can set up complex queries to notify you of specific events or criteria.
  </p>

  <div class="tw-flex tw-gap-4 tw-items-center">
    <a href="https://docs.logflare.app/alerts" target="_blank">Documentation</a>
    <.team_link patch={~p"/alerts/new"} team={@team}>
      <.button variant="primary">
        New alert
      </.button>
    </.team_link>
  </div>
</div>

<section class="mx-auto container">
  <div :if={Enum.any?(@alerts, &is_binary(&1.rule_key))} class="tw-flex tw-justify-end tw-mb-2">
    <button phx-click="toggle-rules-only" class={if @rules_only, do: "btn btn-sm btn-primary", else: "btn btn-sm btn-outline-secondary"}>
      Alert issue rules only
    </button>
  </div>
  <ul :for={alert <- visible_alerts(@alerts, @rules_only)} class="list-group">
    <li class="list-group-item">
      <.team_link team={@team} patch={~p"/alerts/#{alert.id}"} class="tw-text-white">{alert.name}</.team_link>
      <span :if={!alert.enabled} class="badge badge-secondary tw-ml-2">Disabled</span>
      <%= if alert.rule_key do %>
        <span data-rule-badge class={if alert.managed, do: "badge badge-primary tw-ml-2", else: "badge badge-light tw-ml-2"}>
          {if alert.managed, do: "Managed", else: "Custom"}
        </span>
        <span class={"badge badge-#{severity_badge_class(alert.severity)} tw-ml-1"}>{alert.severity}</span>
        <span class="badge badge-secondary tw-ml-1">{alert.category}</span>
        <span data-open-alert-issues class="tw-ml-2 tw-text-sm">
          {Map.get(@open_counts, alert.rule_key, 0)} open
        </span>
        <span class="tw-block tw-text-sm tw-mt-1">
          <code class="tw-text-xs">{alert.rule_key}</code>
          <span class="text-muted tw-ml-2">schedule: {alert.cron}</span>
        </span>
      <% else %>
        <span class="tw-block tw-text-sm">uuid: {alert.token}</span>
      <% end %>
      <p :if={alert.description} class="tw-pb-0 tw-mb-0 tw-text-sm text-muted">
        {alert.description}
      </p>
    </li>
  </ul>
</section>

<section :if={@notification_policies != []} id="notification-policies" class="mx-auto container tw-mt-8">
  <h3 class="tw-text-white">Notification policies</h3>
  <div class="alert alert-info">
    <strong>Managed by Terraform.</strong> Notification policies decide which alert issue changes are sent to the control plane, which fans them out to receivers. Change them in the <code>logflare_alert_notification_policy</code> resource.
  </div>
  <ul class="list-group">
    <li :for={policy <- @notification_policies} data-notification-policy class="list-group-item">
      <span class="tw-text-white">{policy.name}</span>
      <span :if={!policy.enabled} class="badge badge-secondary tw-ml-2">Disabled</span>
      <span class="tw-block tw-text-sm tw-mt-1">
        <span class="text-muted">rules:</span> <code class="tw-text-xs">{policy_list(policy.rule_keys, "any rule")}</code>
        <span class="text-muted tw-ml-2">severity:</span> {policy_severity(policy.min_severity)}
        <span class="text-muted tw-ml-2">categories:</span> {policy_list(policy.categories, "any")}
        <span class="text-muted tw-ml-2">identifiers:</span>
        <code class="tw-text-xs">{policy_list(Enum.map(policy.identifiers, fn {k, v} -> "#{k}=#{v}" end), "any")}</code>
      </span>
      <span class="tw-block tw-text-sm">
        <span class="text-muted">events:</span> {policy_list(policy.events, "none")}
        <span class="text-muted tw-ml-2">repeat:</span> {policy_repeat(policy.repeat_interval_seconds)}
        <span class="text-muted tw-ml-2">receivers:</span> <code class="tw-text-xs">{policy_list(policy.receivers, "none")}</code>
      </span>
    </li>
  </ul>
</section>
